# Anthropic API Key — get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — get keys from dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Resend — email delivery, get key at resend.com
RESEND_API_KEY=re_...

# Supabase — resume history / magic links (supabase.com → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Your live domain (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://resumerocket.co
