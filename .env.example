# Supabase — auth, database (listings/offers/notifications/messages), and
# storage (listing photos) all run on this one project. Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Your real deployed URL. Used in email links and page metadata/SEO tags.
NEXT_PUBLIC_BASE_URL=https://worthcars.com

# Optional — email. Without RESEND_API_KEY, offer/message notifications
# still work in-app, they just don't also send as email.
RESEND_API_KEY=
# Until you verify a sending domain in Resend, leave this unset and it
# falls back to Resend's own onboarding@resend.dev sandbox address.
RESEND_FROM_EMAIL=

# Optional — protects the scheduled reminder job (vercel.json) so the
# reminder emails can't be triggered by hitting the URL directly. Any
# random string; Vercel Cron sends it automatically as a bearer token
# once this env var exists.
CRON_SECRET=
