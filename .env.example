# Supabase (used for lookup logging, ticker stats, and stored paid reports)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (one-time payment for the full history report)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Valuation + vehicle history data provider (VinAudit) — see README for details.
# Leave blank in dev to fall back to clearly-labeled demo data.
VINAUDIT_MARKET_VALUE_KEY=
VINAUDIT_HISTORY_KEY=

# Simple password gate for /admin (no user accounts in this app)
ADMIN_PASSWORD=

NEXT_PUBLIC_BASE_URL=https://worthcars.com
